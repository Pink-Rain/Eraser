{
  "manifest_version": 3,
  "name": "Eraser — Compagnon Roll20",
  "version": "0.7.0",
  "description": "Synchronise une campagne ou une session de l’application Eraser avec Roll20.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:32147/*", "https://app.roll20.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://app.roll20.net/editor/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
